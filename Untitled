# __Fault traces from digitized data ___________________________________________
def load_fault(path):
    lons, lats = [], []
    with open(path) as f:
        for line in f:
            parts = line.strip().replace(',', ' ').split()
            if len(parts) >= 2:
                try:
                    lons.append(float(parts[0]))
                    lats.append(float(parts[1]))
                except:
                    pass
    return np.array(lons), np.array(lats)

